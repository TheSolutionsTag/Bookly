    "googleapis": "^178.1.1",
    "ics": "^3.12.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.5.0",
    "node-ical": "^0.27.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.24.1"
