PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5455/helebooker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
NODE_ENV=development
LOG_LEVEL=info

# Used only once, by `npm run seed`, to create the first ADMIN account.
# After that, log in and create further accounts from the Users screen.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Where the frontend runs - the Google OAuth callback redirects here after
# connecting or on error (e.g. http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# Google Calendar integration (optional). Leave blank to leave it disabled.
# See README "Google Calendar integration" for how to get these for free.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback

# Microsoft Outlook/Teams Calendar integration (optional). See README.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/integrations/microsoft/callback
MICROSOFT_TENANT=common

# Zoom meeting generation (optional). See README.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:4000/integrations/zoom/callback

# Calendly webhook receiver (optional, requires a paid Calendly plan on
# the connecting business's side). See README.
CALENDLY_WEBHOOK_SIGNING_KEY=

# How often the ICS feed subscription job re-fetches every feed.
ICS_FEED_SYNC_INTERVAL_MINUTES=20
